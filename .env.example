# ── LLM backend (for /ask endpoint) ──────────────────────────────────────────
# Set LLM_BACKEND to "ollama", "gemini" or "anthropic" (default: anthropic)
# Search, definition and impact never use an LLM.

LLM_BACKEND=gemini          # or "ollama" (free, local) / "anthropic"

# Ollama (free, runs locally — https://ollama.com; then `ollama pull qwen2.5-coder:7b`)
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_TIMEOUT=600        # seconds; large models on small machines can be slow

# Gemini (free tier — get key at https://aistudio.google.com)
GEMINI_API_KEY=AIza...

# Anthropic (optional, only needed if LLM_BACKEND=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model for the hosted backends
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-flash-latest

# ── Embedding backend ─────────────────────────────────────────────────────────
EMBEDDING_BACKEND=local     # "local" (sentence-transformers) or "openai"
# Local model for new ingests (default BAAI/bge-small-en-v1.5). Each repo keeps
# the model it was ingested with, so changing this only affects future ingests.
# EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=sk-...       # only needed if EMBEDDING_BACKEND=openai
