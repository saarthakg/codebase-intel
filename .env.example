# ── LLM backend (for /ask endpoint) ──────────────────────────────────────────
# Set LLM_BACKEND to "gemini" or "anthropic" (default: anthropic)

LLM_BACKEND=gemini          # or "anthropic"

# Gemini (free tier — get key at https://aistudio.google.com)
GEMINI_API_KEY=AIza...

# Anthropic (optional, only needed if LLM_BACKEND=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model for either backend
# ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-flash-latest

# ── Embedding backend ─────────────────────────────────────────────────────────
EMBEDDING_BACKEND=local     # "local" (sentence-transformers) or "openai"
# Local model for new ingests (default BAAI/bge-small-en-v1.5). Each repo keeps
# the model it was ingested with, so changing this only affects future ingests.
# EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=sk-...       # only needed if EMBEDDING_BACKEND=openai
