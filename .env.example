# codebase-intel needs no API keys or models: everything runs locally from the
# repo's source and git history. Optional settings:

# Files larger than this are skipped (generated, vendored or data files).
# INGEST_MAX_FILE_BYTES=1000000

# MCP server: the repo to use when a tool call doesn't name one.
# CODEBASE_INTEL_REPO_ID=my-repo
